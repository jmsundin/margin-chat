HOST=127.0.0.1
PORT=8787
BACKEND_PORT=8787
DEFAULT_BACKEND_PROVIDER=openai-api
AUTH_SESSION_DAYS=30
SECURE_AUTH_COOKIES=false
APP_URL=http://127.0.0.1:5173
PASSWORD_RESET_MINUTES=60
PASSWORD_RESET_FROM_EMAIL=Margin Chat <passwords@example.com>
RESEND_API_KEY=your_resend_api_key

DATABASE_URL=postgresql://margin_chat:margin_chat@127.0.0.1:5432/margin_chat
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=margin_chat
PGUSER=margin_chat
PGPASSWORD=margin_chat
POSTGRES_SSL=false
# Set POSTGRES_SSL=true for hosted Postgres providers such as Neon in production.

# Markdown vault: server-only credentials, never prefix these with VITE_.
# On Vercel, connect a PRIVATE Blob store to this project. Vercel can supply
# BLOB_STORE_ID and OIDC authentication; a read/write token is also supported.
# BLOB_STORE_ID=store_your_private_store_id
# BLOB_READ_WRITE_TOKEN=your_private_blob_read_write_token
# Local development alternative: a durable directory, relative to the server cwd.
# This setting takes precedence over Blob and is rejected on Vercel.
# VAULT_STORAGE_DIR=.margin-chat-vault
# See docs/markdown-vault.md for migration, offline storage and recovery.

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-pro-preview

HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=openai/gpt-oss-120b
# HF_TOKEN is also supported as the Hugging Face credential.

XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.5

# Generate once with: openssl rand -base64 32
# Keep this stable; changing it makes saved user API keys unreadable.
API_KEY_ENCRYPTION_KEY=your_32_byte_base64_key

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Stripe Price used by the subscription Checkout flow.
STRIPE_PRICE_ID=price_...
# Recommended hosted-usage flow: a one-time Checkout price funds an internal
# wallet. This example grants $10.00 (10,000,000 microdollars) per purchase.
STRIPE_CREDIT_PRICE_ID=price_...
STRIPE_CREDIT_AMOUNT_MICROS=10000000
# Flat charge per successful hosted chat request. Set this above your expected
# provider cost, including the automatically generated title request.
HOSTED_API_REQUEST_PRICE_MICROS=25000
HOSTED_MAX_INPUT_CHARACTERS=60000
HOSTED_MAX_OUTPUT_TOKENS=2000
