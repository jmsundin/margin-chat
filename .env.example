HOST=127.0.0.1
PORT=8787
BACKEND_PORT=8787
DEFAULT_BACKEND_PROVIDER=openai-api
AUTH_SESSION_DAYS=30
SECURE_AUTH_COOKIES=false
APP_URL=http://127.0.0.1:5173
PASSWORD_RESET_MINUTES=60
PASSWORD_RESET_FROM_EMAIL=Margin Chat <passwords@example.com>
RESEND_API_KEY=your_resend_api_key

DATABASE_URL=postgresql://margin_chat:margin_chat@127.0.0.1:5432/margin_chat
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=margin_chat
PGUSER=margin_chat
PGPASSWORD=margin_chat
POSTGRES_SSL=false
# Set POSTGRES_SSL=true for hosted Postgres providers such as Neon in production.

# Markdown vault: server-only credentials, never prefix these with VITE_.
# On Vercel, connect a PRIVATE Blob store to this project. Vercel can supply
# BLOB_STORE_ID and OIDC authentication; a read/write token is also supported.
# BLOB_STORE_ID=store_your_private_store_id
# BLOB_READ_WRITE_TOKEN=your_private_blob_read_write_token
# Local development alternative: a durable directory, relative to the server cwd.
# This setting takes precedence over Blob and is rejected on Vercel.
# VAULT_STORAGE_DIR=.margin-chat-vault
# See docs/markdown-vault.md for migration, offline storage and recovery.

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-pro-preview

HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=openai/gpt-oss-120b
# HF_TOKEN is also supported as the Hugging Face credential.

XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4.5

# Generate once with: openssl rand -base64 32
# Keep this stable; changing it makes saved user API keys unreadable.
API_KEY_ENCRYPTION_KEY=your_32_byte_base64_key

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional existing active $20.00 USD monthly licensed Price. If omitted,
# Checkout creates the same recurring price inline. No free trial credit.
# STRIPE_PRICE_ID=price_...
# Optional dedicated Customer Portal configuration; omitted uses Stripe's default.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Enable Stripe Dashboard > Business > Customer emails > Successful payments
# for emailed subscription receipts. Top-ups explicitly set receipt_email.
# See docs/billing.md for webhooks, provider usage prices and local testing.
# Required for hosted members: exact provider:model prices in microdollars per
# million tokens. Unlisted models fail closed. Set current, verified provider
# rates before enabling; this commented example contains illustrative values.
# HOSTED_MODEL_PRICES_JSON={"openai:YOUR_MODEL":{"inputMicrosPerMillionTokens":1000000,"outputMicrosPerMillionTokens":2000000},"openai:text-embedding-3-small":{"inputMicrosPerMillionTokens":1000000,"outputMicrosPerMillionTokens":0}}
# Gemini entries also require maxReasoningTokens. See docs/hosted-usage-metering.md.
HOSTED_MAX_INPUT_CHARACTERS=60000
HOSTED_MAX_OUTPUT_TOKENS=2000
