{
  "manifest_version": 3,
  "name": "Margin Chat",
  "description": "Your thinking space above the web: highlight, comment, save sources, and take page context into AI conversations.",
  "minimum_chrome_version": "127",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open Margin on this page"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{
    "resources": ["workspace.html", "assistant.html", "assets/*", "excalidraw/*"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
