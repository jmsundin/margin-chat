# Nonsecret settings for an isolated, authorized provider smoke test.
# Verified prices and scope: ../hosted-usage-metering.md
DEFAULT_BACKEND_PROVIDER=openai-api
OPENAI_MODEL=gpt-5.6-luna
HOSTED_MAX_INPUT_CHARACTERS=6000
HOSTED_MAX_OUTPUT_TOKENS=128
HOSTED_MODEL_PRICES_JSON='{"openai:gpt-5.6":{"inputMicrosPerMillionTokens":4000000,"cachedInputMicrosPerMillionTokens":400000,"cacheWriteInputMicrosPerMillionTokens":5000000,"outputMicrosPerMillionTokens":20000000},"openai:gpt-5.6-luna":{"inputMicrosPerMillionTokens":200000,"cachedInputMicrosPerMillionTokens":20000,"cacheWriteInputMicrosPerMillionTokens":250000,"outputMicrosPerMillionTokens":1200000},"openai:text-embedding-3-small":{"inputMicrosPerMillionTokens":20000,"outputMicrosPerMillionTokens":0}}'
