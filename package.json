{
  "name": "margin-chat",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "extension",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:client": "bun run --cwd client dev",
    "dev:full": "bun scripts/dev.mjs",
    "dev:server": "bun --watch server/index.mjs",
    "db:logs": "docker compose logs -f postgres",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "migrate:workspace": "bun scripts/migrate-workspace-json-to-markdown.ts",
    "build": "bun run build:vault-codec && bun run --cwd client build",
    "build:extension": "bun run --cwd extension build",
    "release:extension": "bun run --cwd extension release",
    "preview": "bun run --cwd client preview",
    "start:server": "node server/index.mjs",
    "test": "bun run build:vault-codec && bun test",
    "build:vault-codec": "bun scripts/build-vault-codec.mjs"
  },
  "dependencies": {
    "@margin-chat/capture-contracts": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.10.0",
    "pdf-parse": "1.1.1",
    "pg": "^8.20.0",
    "stripe": "^20.4.1",
    "vercel": "^58.9.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9"
  }
}
